{
  "servers": {
    "tsgo": {
      "command": "tsgo",
      "args": ["--lsp", "--stdio"],
      "fileTypes": [".ts", ".tsx", ".mts", ".cts", ".mjs", ".js", ".jsx", ".cjs"],
      "rootMarkers": ["tsconfig.json"]
    },
    "typescript-language-server": {
      "disabled": true
    },
    "astro": {
      "initOptions": {
        "typescript": {
          "tsdk": "node_modules/typescript/lib"
        }
      }
    },
    "oxlint": {
      "command": "oxlint",
      "args": ["--lsp"],
      "fileTypes": [".ts", ".tsx", ".mts", ".cts", ".mjs", ".js", ".jsx", ".cjs"],
      "rootMarkers": ["oxlint.config.mts"],
      "isLinter": true
    },
    "oxfmt": {
      "command": "oxfmt",
      "args": ["--lsp"],
      "fileTypes": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".mjs",
        ".js",
        ".jsx",
        ".cjs",
        ".json",
        ".jsonc"
      ],
      "rootMarkers": ["oxfmt.config.mts"],
      "isLinter": true
    }
  }
}
